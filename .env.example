# ====================
# ACE-RAG 环境配置模板
# ====================
# 复制为 .env 并填写实际值

# --- 基础 ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ace_rag
POSTGRES_USER=ace_rag
POSTGRES_PASSWORD=changeme

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Elasticsearch ---
ES_HOST=http://localhost:9200
ES_INDEX_PREFIX=ace_rag

# --- Milvus (向量数据库) ---
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=ace_rag_chunks

# --- LLM ---
# OpenAI 兼容接口
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o

# 小模型（意图识别、实体抽取）
LLM_SMALL_MODEL=gpt-4o-mini

# Embedding 模型
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Reranker 模型
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- 检索配置 ---
RETRIEVAL_DEFAULT_TOP_K=20
RETRIEVAL_DEFAULT_RERANK_TOP_N=8
RETRIEVAL_DEFAULT_TIMEOUT_MS=1000

# --- Agent 预算 ---
AGENT_MAX_RETRIEVAL_ROUNDS=3
AGENT_MAX_REWRITES=2
AGENT_MAX_SUBTASKS=10
AGENT_MAX_TOOL_CALLS=5
AGENT_TOTAL_TIMEOUT_MS=30000
AGENT_TOTAL_TOKEN_BUDGET=50000

# --- 证据充分性 ---
EVIDENCE_SUFFICIENCY_THRESHOLD=0.85
EVIDENCE_RETRY_THRESHOLD=0.85
EVIDENCE_MAX_RETRIES=2

# --- 会话 ---
SESSION_TTL_SECONDS=3600
SESSION_MAX_TURNS=20

# --- 可观测性 ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- 知识库版本 ---
INDEX_EPOCH=kb-2026-07
