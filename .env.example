# ====================
# ACE-RAG 环境配置模板
# ====================
# 复制为 .env 并填写实际值

# --- 基础 ---
APP_ENV=development
APP_DEBUG=true

# --- LLM（B组回答生成）---
# OpenAI 兼容接口，默认指向 DeepSeek
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-chat
# 小模型（意图识别、改写等轻量任务，可复用主模型）
LLM_SMALL_MODEL=deepseek-chat

# --- Embedding 模型（A组向量化）---
# 本地运行，通过 ModelScope 下载
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Reranker（可选，未启用时跳过精排）
RERANKER_MODEL=BAAI/bge-reranker-large

# --- Redis（可选 — 未配置时自动降级为内存模式）---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- 检索配置 ---
RETRIEVAL_DEFAULT_TOP_K=20

# --- Agent 预算 ---
AGENT_MAX_RETRIEVAL_ROUNDS=3
AGENT_MAX_REWRITES=2
AGENT_MAX_SUBTASKS=10
AGENT_MAX_TOOL_CALLS=5
AGENT_TOTAL_TIMEOUT_MS=30000
AGENT_TOTAL_TOKEN_BUDGET=50000

# --- 证据充分性 ---
EVIDENCE_SUFFICIENCY_THRESHOLD=0.85
EVIDENCE_RETRY_THRESHOLD=0.85
EVIDENCE_MAX_RETRIES=2

# --- 会话 ---
SESSION_TTL_SECONDS=3600
SESSION_MAX_TURNS=20

# --- 日志 ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- 知识库版本 ---
INDEX_EPOCH=kb-2026-07
